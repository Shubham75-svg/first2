<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".BillingReceiptActivity">

    <!-- ====== Main Content with Menu Icon Inside ScrollView ====== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="50dp"
        android:paddingVertical="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Menu Icon Row (Top Left inside ScrollView) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="20dp">

                <!-- Menu Icon (Opens Profile/Settings) - LEFT SIDE -->
                <ImageView
                    android:id="@+id/menuIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Menu"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="0dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- Spacer to push content to the right if needed -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- Main Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="28dp">

                <!-- Welcome Message -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="40dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/ic_app_logo"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.03"
                        android:text="Emergency Alert System"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.8"
                        android:text="Press the panic button in case of emergency"
                        android:textColor="#BBDEFB"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- ====== EMERGENCY PANIC BUTTON ====== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/panicButtonCard"
                    android:layout_width="300dp"
                    android:layout_height="400dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#FF3B30"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FF3B30"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/panic_button_gradient"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="30dp">

                        <!-- Emergency Icon/Image -->
                        <ImageView
                            android:id="@+id/panicButtonImage"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginBottom="20dp"
                            android:src="@drawable/emergency_icon"
                            android:tint="#FFFFFF" />

                        <!-- Emergency Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:letterSpacing="0.03"
                            android:text="EMERGENCY PANIC ALERT"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Emergency Instructions -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:alpha="0.9"
                            android:gravity="center"
                            android:text="Press the button below in case of emergency"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <!-- Divider Line -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginBottom="20dp"
                            android:alpha="0.4"
                            android:background="#FFFFFF" />

                        <!-- Large Panic Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/panicButton"
                            style="@style/Widget.Material3.Button.ElevatedButton"
                            android:layout_width="220dp"
                            android:layout_height="70dp"
                            android:backgroundTint="#FFFFFF"
                            android:letterSpacing="0.04"
                            android:text="PRESS FOR EMERGENCY"
                            android:textColor="#FF3B30"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="35dp"
                            app:elevation="12dp" />

                        <!-- Warning Text -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:alpha="0.7"
                            android:gravity="center"
                            android:text="Use only in real emergencies"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Emergency Instructions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:text="This will immediately alert emergency contacts"
                    android:textColor="#90CAF9"
                    android:textSize="14sp" />

                <!-- ====== HEALTH SCORE BUTTON ====== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/healthScoreCard"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginBottom="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#1A1A2E"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <!-- Health Icon -->
                        <ImageView
                            android:layout_width="66dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="50dp"
                            android:src="@drawable/ic_health"
                            app:tint="#4FC3F7" />

                        <!-- Health Score Content -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Health Score"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check health status"
                                android:textColor="#BBDEFB"
                                android:textSize="19sp"/>

                        </LinearLayout>

                        <!-- Arrow Icon -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="#4FC3F7" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>