<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <!-- Watch Icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_watch"
        android:tint="#FFFFFF"
        android:layout_marginBottom="32dp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect Smart Watch"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Download our app on your smart watch"
        android:textColor="#BBDEFB"
        android:textSize="14sp"
        android:layout_marginBottom="40dp"
        android:gravity="center" />

    <!-- Download Buttons Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1A1A2E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Apple Watch Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppleWatch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Apple Watch"
                android:textColor="#1A1A2E"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="#4FC3F7"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <!-- Samsung Watch Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSamsungWatch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Samsung Watch"
                android:textColor="#1A1A2E"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="#4FC3F7"
                app:elevation="2dp"
                android:layout_marginBottom="12dp" />

            <!-- Wear OS Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWearOs"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Wear OS"
                android:textColor="#1A1A2E"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="#4FC3F7"
                app:elevation="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Connection Progress Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1A1A2E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- Progress Title -->
            <TextView
                android:id="@+id/tvProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connecting to Apple Watch..."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginBottom="16dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressTint="#4FC3F7"
                android:progressBackgroundTint="#666666" />

            <!-- Progress Status -->
            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initializing connection..."
                android:textColor="#BBDEFB"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <!-- Progress Percentage -->
            <TextView
                android:id="@+id/tvProgressPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#4FC3F7"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scan Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan with your watch camera"
        android:textColor="#90CAF9"
        android:textSize="12sp" />

    <!-- Back Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="BACK"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="15dp"
        app:backgroundTint="#666666"
        app:elevation="2dp" />

</LinearLayout>